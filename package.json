{
  "name": "@lumine-code/fs-plus",
  "version": "1.0.0",
  "description": "Extends Node.js filesystem APIs with cross-platform helpers.",
  "main": "./lib/fs-plus.js",
  "scripts": {
    "build": "node scripts/build.js",
    "pretest": "npm run build",
    "test": "jasmine",
    "prepare": "npm run build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write ."
  },
  "repository": "https://github.com/lumine-code/fs-plus",
  "bugs": "https://github.com/lumine-code/fs-plus/issues",
  "homepage": "https://github.com/lumine-code/fs-plus/",
  "license": "MIT",
  "author": "lumine-code",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "fs",
    "filesystem",
    "node",
    "path",
    "cross-platform",
    "file",
    "lumine"
  ],
  "files": [
    "lib",
    "THIRD_PARTY_NOTICES"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "jasmine": "^7.0.0",
    "prettier": "^3.10.0"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    },
    "jasmine@^7.0.0": {
      "glob": "14.0.5"
    }
  }
}
